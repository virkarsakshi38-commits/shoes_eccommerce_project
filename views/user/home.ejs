<!-- Shop by Style Section -->
<section class="shop-by-style py-5 bg-light-pink">
  <div class="container">
    <div class="section-header">
      <h2>Shop by Style</h2>
      <p class="text-muted">Discover your perfect look with our curated style collections</p>
    </div>
    <div class="row">
      <% for(var i=0; i < product_styles.length; i++) { %>
        <div class="col-lg-3 col-md-6 mb-4">
          <div class="product-card">
            <div class="position-relative">
              <span class="style-tag">Casual</span>
              <img src="/styles/<%= product_styles[i].product_style_image %>" 
                   class="card-img-top product-img" 
                   alt="<%= product_styles[i].product_style_name %>">
