  <!-- Hero Carousel -->
  <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
         <% for(var i=0;i<sliders.length;i++){ %>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="<%-i%>" class="<%= (i==0) ? 'active':'' %>"></button>
       <% } %>
      <!-- <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button> -->
    </div>


    
    <div class="carousel-inner">
      <!-- Slide 1 -->
       <% for(var i=0;i<sliders.length;i++){ %>
      <div class="carousel-item <%= (i==0) ? 'active':'' %>">
        <img src="<%-sliders[i].slider_image%>" class="d-block w-100" alt="Sneaker Collection">
        <div class="carousel-caption d-none d-md-block">
          <h3><%-sliders[i].slider_description%></h3>
          <p>Discover our latest designs in vibrant colors</p>
          <a href="<%-sliders[i].slider_button_link%>" class="btn btn-light btn-pink"><%-sliders[i].slider_button_text%></a>
        </div>
      </div>
    <% } %>

    
    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
  </div>



 <!-- Trending Products Section -->
    <section class="trending-section">
        <div class="container">
            <div class="section-title">
                <h2>🔥 Trending Now</h2>
            </div>
            
            <div class="row">
                <!-- Product 1 -->

         <% for(var i=0;i<trending_products.length;i++){ %>
                <div class="col-lg-3 col-md-6">
                    <div class="trending-card">
                        <span class="trending-badge">HOT</span>

                        <a href="/product_details/<%-trending_products[i].product_id%>">
                          
                        <img src="/products/<%-trending_products[i].product_main_image%>" class="product-img" alt="Cloudfoam Sneakers">
                        <div class="card-body">
                            <h5 class="product-title"><%-trending_products[i].product_name%></h5>
                            <div class="trending-stats">
                                <span><i class="bi bi-lightning-charge-fill text-pink"></i> 2.5k+ sold</span>
                                <span><i class="bi bi-star-fill text-warning"></i> 4.8</span>
                            </div>
                            <p class="product-price">&#8377; <%-trending_products[i].product_price%></p>
                            <button class="btn-pink">Buy Now</button>
                        </div>
                    </div>
                    </a>
                </div>
                <% } %>





    </section>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



  

