            <div class="card-body text-center">
              <h5 class="card-title"><%= product_styles[i].product_style_name %></h5>
              <p class="card-text">Perfect for everyday wear with maximum comfort</p>
              <p class="text-pink fw-bold">$49.99</p>
              <a href="#" class="btn btn-pink">Add to Cart</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>





  


