<div class="container mt-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <!-- Brand Form Section -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Product Brand</h5>
                </div>
                <div class="card-body">
                    <form action="/admin/save_product_brand" method="post">
                        <div class="mb-3">
                            <label for="product_brand_name" class="form-label">Brand Name</label>
                            <input type="text" class="form-control" id="product_brand_name" name="product_brand_name" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <!-- Brand Table Section -->
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Existing Product Brands</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-hover text-center align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Action</th>
                                <th>Sr. No</th>
                                <th>Brand Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(var i = 0; i < brands.length; i++) { %>
                                <tr>
                                    <td>
                                        <a href="/admin/edit_product_brand/<%= brands[i].product_brand_id %>" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                        <a href="/admin/delete_product_brand/<%= brands[i].product_brand_id %>" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                    <td><%= i + 1 %></td>
                                    <td><%= brands[i].product_brand_name %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

